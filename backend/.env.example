OPENAI_API_KEY=sk-your-openai-key
DATABASE_URL=postgresql://admin:ics1802026@db:5432/product_db

# Shared-secret admin key required on /api/lead/* and /api/maintenance/*
# (X-Admin-Api-Key header). Generate with: openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-random-secret

# Signs session tokens for GET /api/session/{id}. Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=change-me-to-a-random-secret

# Persists conversation sessions in Redis so they survive a backend restart
# and are shared across multiple worker processes. docker-compose.yml sets
# this automatically (redis://redis:6379/0) — set it here only when running
# the backend outside Docker. If unset, sessions fall back to an in-memory
# store: fine for local dev/test, NOT safe for production.
# REDIS_URL=redis://localhost:6379/0

# Browser origins allowed to call this API (comma-separated). Defaults to the
# Vite dev server, so local development needs no value here. Set this to the
# real site origin(s) when deploying — e.g. the page the chat widget is
# embedded on. Include the scheme, and no trailing slash:
# CORS_ALLOW_ORIGINS=https://idtechproducts.com,https://www.idtechproducts.com